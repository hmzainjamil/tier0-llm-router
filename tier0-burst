    ("qwen2.5-coder-7b-instruct-q4_0.gguf",        "Qwen2.5-Coder-7B",  "code",   True,  False),
    # Broken in GPT4All 2.8.2 — needs llama-cpp-python with newer llama.cpp
    ("mistral-7b-instruct-v0.1.Q4_0.gguf",         "Mistral-7B",        "medium", True,  True),
    ("DeepSeek-R1-Distill-Qwen-1.5B-Q4_0.gguf",  "DeepSeek-R1-1.5B",  "fast",   False, True),

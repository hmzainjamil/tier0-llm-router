#!/usr/bin/env python3
"""
tier0-burst — Parallel model comparison across ALL Tier 0 sources.

Usage:
  tier0-burst "your prompt here"
  tier0-burst --max-tokens 200 "your prompt"
  tier0-burst --mode fast "quick question"     # small models only (faster)
  tier0-burst --mode full "complex task"       # all models (comprehensive)
  tier0-burst --mode cloud "summarize X"       # cloud models only via G0DM0D3
  tier0-burst --mode local "code task"         # local GPT4All only

Output: ranked responses with scores, winner highlighted.
"""


async def call_kimi(prompt: str, session, model: str = "moonshot-v1-8k") -> dict:
    """Kimi/Moonshot — caveman-compressed, min tokens always, all models"""
    if not KIMI_KEY: return {"model": model, "text":"","score":0,"latency":0,"skip":True}
    t0 = time.time()
    try:
        headers = {"Authorization": f"Bearer {KIMI_KEY}", "Content-Type": "application/json"}
        # CAVEMAN — hardcoded on ALL Kimi models forever (incl. future k3, k4 etc.)
        system = ("Reply ULTRA SHORT. No filler. No repeat. Bullet points only if needed. "
                  "Max 150 words unless code. Never say 'certainly' or 'here is'. Just answer.")
        body = {
            "model": model,
            "messages": [
                {"role": "system", "content": system},
                {"role": "user",   "content": prompt}
            ],
            "max_tokens": 1024,
            "temperature": 0.3,
        }
        async with session.post(f"{KIMI_BASE}/chat/completions",
                                headers=headers, json=body,
                                timeout=aiohttp.ClientTimeout(total=30)) as r:
            d = await r.json()
            text = d["choices"][0]["message"]["content"]
            return {"model": model, "text": text, "score": score_response(text, prompt) + 3,
                    "latency": round(time.time()-t0, 2)}
    except Exception as e:
        return {"model": model, "text":"","score":0,"latency":round(time.time()-t0,2),"error":str(e)}


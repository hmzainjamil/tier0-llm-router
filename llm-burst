GPT4ALL_DIR = Path.home() / "Library/Application Support/nomic.ai/GPT4All"

def call_gpt4all_sync(model_key: str, prompt: str) -> dict:
    """Run GPT4All model synchronously (blocking — runs in thread pool)."""
    t0 = time.time()
    model_file = GPT4ALL_MODELS.get(model_key)
    if not model_file:
        return {"model": f"gpt4all:{model_key}", "text": "", "score": 0, "latency": 0, "skip": True}
    full_path = GPT4ALL_DIR / model_file
    if not full_path.exists():
        return {"model": f"gpt4all:{model_key}", "text": "", "score": 0, "latency": 0, "skip": True}
    try:
        import gpt4all
        model = gpt4all.GPT4All(str(full_path), allow_download=False, verbose=False)
        # DeepSeek-R1 distill models need thinking stripped out
        is_deepseek = "deepseek" in model_key.lower()
        with model.chat_session():
            resp = model.generate(prompt, max_tokens=600, temp=0.7)
        text = resp.strip() if isinstance(resp, str) else str(resp)
        # Strip DeepSeek think tags if present
        if is_deepseek:
            import re as _re
            text = _re.sub(r'<think>.*?</think>', '', text, flags=_re.DOTALL).strip()
        return {"model": f"gpt4all:{model_key}", "text": text,
                "score": score_response(text, prompt) + 5,  # +5 local bonus (zero cost)
                "latency": round(time.time() - t0, 2)}
    except Exception as e:
        return {"model": f"gpt4all:{model_key}", "text": "", "score": 0,
                "latency": round(time.time() - t0, 2), "error": str(e)[:80]}

async def call_gpt4all(model_key: str, prompt: str) -> dict:
    """Wrap blocking GPT4All call in asyncio thread pool."""
    loop = asyncio.get_event_loop()
    return await loop.run_in_executor(None, call_gpt4all_sync, model_key, prompt)

# ── RAM safety check ─────────────────────────────────────────────
def get_free_ram_gb() -> float:
    try:
        import subprocess, re
        out = subprocess.check_output(["vm_stat"], timeout=3).decode()
        free  = int(re.search(r'Pages free:\s+(\d+)', out).group(1))
        inact = int(re.search(r'Pages inactive:\s+(\d+)', out).group(1))
        return (free + inact) * 4096 / 1024**3
    except Exception:
        return 2.0  # assume low if check fails


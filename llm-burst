# ── Main burst ───────────────────────────────────────────────────
async def burst(prompt: str, models: list = None) -> dict:
    import aiohttp
    ram_gb = get_free_ram_gb()

    if models:
        # Expand shorthands
        expanded = []
        for m in models:
            if m == "gpt4all":
                # Safety: only allow if RAM > 6GB
                if ram_gb < 6.0:
                    print(f"⚠ GPT4All skipped — only {ram_gb:.1f}GB free RAM (need 6GB+)", file=sys.stderr)
                else:
                    expanded += list(LOCAL_HEAVY.keys())
            elif m == "local":
                expanded += list(LOCAL_LIGHT.keys())
            else:
                expanded.append(m)
        callers = {k: v for k,v in ALL.items() if k in expanded}
    else:
        # Default burst: Kimi K2.6 FIRST + all cloud + Ollama
        # Kimi K2.6 leads — 262K context, vision, video, reasoning — Opus replacement at 5% cost
        callers = {}
        callers["kimi-k2.6"]  = call_kimi_k26   # #1 — ALWAYS first
        callers["kimi-k2.5"]  = call_kimi_k25   # #2 — reasoning backup
        callers["groq"]       = call_groq        # #3 — free, fast
        callers["gemini"]     = call_gemini      # #4 — free 1500/day
        callers["deepseek"]   = call_openrouter_deepseek  # #5 — free
        callers["nemotron"]   = call_openrouter_nemotron  # #6 — free
        callers["gemma4"]     = call_openrouter_gemma     # #7 — free
        callers["gpt4o"]      = call_gpt4o_mini  # #8 — paid, skips if no credits
        callers["glm"]        = call_glm         # #9 — paid, skips if no credits
        callers["ollama"]     = call_ollama      # #10 — local, LaunchAgent persistent
        callers["bytez"]      = call_bytez       # #11 — bytez.com free tier

    async with aiohttp.ClientSession() as session:
        tasks = [fn(prompt, session) for fn in callers.values()]
        results = await asyncio.gather(*tasks, return_exceptions=True)

    valid = []
    for r in results:
        if isinstance(r, dict) and r.get("text") and not r.get("skip"):
            valid.append(r)

    if not valid:
        return {"winner": None, "text": "", "all": []}

    valid.sort(key=lambda x: x["score"], reverse=True)
    winner = valid[0]
    return {"winner": winner["model"], "text": winner["text"],
            "score": winner["score"], "latency": winner["latency"],
            "all": valid}

# ── CLI entry ─────────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(description="Multi-LLM burst + judge")
    parser.add_argument("prompt", nargs="?", default=None)
    parser.add_argument("--models", default=None, help="Comma-separated model list")
    parser.add_argument("--json", action="store_true", help="Output full JSON")
    parser.add_argument("--meta", action="store_true", help="Show winner metadata on stderr")
    args = parser.parse_args()

    if args.prompt:
        prompt = args.prompt
    elif not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    else:
        print("Usage: llm-burst 'your prompt'", file=sys.stderr)
        sys.exit(1)

    models = args.models.split(",") if args.models else None
    result = asyncio.run(burst(prompt, models))

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        if result["text"]:
            print(result["text"])
            if args.meta or os.environ.get("LLM_BURST_META"):
                print(f"\n[Winner: {result['winner']} | score:{result['score']} | {result['latency']}s | {len(result['all'])} models raced]", file=sys.stderr)
        else:
            print("[llm-burst] All models failed or unavailable", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()


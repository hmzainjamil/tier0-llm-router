# ── Score a response (judge logic) ───────────────────────────────
def score_response(text: str, prompt: str) -> float:
    if not text or len(text) < 20:
        return 0.0
    score = 0.0
    # Length reward (up to 300 words is ideal)
    words = len(text.split())
    score += min(words / 300, 1.0) * 30
    # Completeness: does it address the prompt?
    prompt_words = set(re.findall(r'\w+', prompt.lower()))
    resp_words   = set(re.findall(r'\w+', text.lower()))
    overlap = len(prompt_words & resp_words) / max(len(prompt_words), 1)
    score += overlap * 25
    # Structure bonus (bullets, numbered lists)
    if re.search(r'^\s*[-•*\d]\s', text, re.M):
        score += 10
    # No error/refusal penalty
    if re.search(r"(I cannot|I'm unable|I can't|error|sorry, i|as an AI)", text, re.I):
        score -= 20
    # Actionable content
    if re.search(r'\b(step|action|do|use|run|check|add|create|build)\b', text, re.I):
        score += 10
    # Concise + dense
    if 50 < words < 800:
        score += 15
    return round(score, 2)

